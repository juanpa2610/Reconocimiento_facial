# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE RECONOCIMIENTO BIOMÉTRICO BASADO EN EMBEDDINGS
# ==============================================================================

# Motor de Base de Datos: 'sqlite' o 'postgres'
DB_ENGINE=sqlite

# Configuración para SQLite (archivo local)
SQLITE_DB_PATH=biometric_templates.db

# Configuración para PostgreSQL (solo si DB_ENGINE=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=biometria_db
PG_USER=postgres
PG_PASSWORD=tu_contraseña_aqui

# Parámetros Biométricos
# Umbral de distancia euclidiana L2 (Valores típicos: 0.50 a 0.60)
# Menor valor = mayor rigor (menor falso positivo, mayor falso rechazo)
# Mayor valor = menor rigor
FACE_DISTANCE_THRESHOLD=0.55

# Origen de Video (0 para cámara web por defecto, o URL RTSP/HTTP para cámara IP)
VIDEO_SOURCE=0
# Ejemplo Tapo C310 (cámara IP). Crea primero la 'Cuenta de cámara' en la app Tapo
# (Ajustes > Avanzado > Cuenta de cámara). Usa stream2 (baja resolución) para MENOS delay:
# VIDEO_SOURCE=rtsp://USUARIO:CLAVE@192.168.1.XX:554/stream2

# Cooldown en segundos entre registros de acceso sucesivos de un mismo alumno
ACCESS_LOG_COOLDOWN_SECONDS=10.0

# --- Rendimiento / baja latencia ---
# Transporte RTSP: tcp (estable en Wi-Fi) o udp (a veces un poco más rápido)
RTSP_TRANSPORT=tcp
# Ancho máximo al que se reduce cada cuadro en el hilo lector (0 = sin reducir)
CAMERA_MAX_WIDTH=960
# Ancho de la imagen que ve el detector de rostros (menor = más rápido, ve menos de lejos)
DETECTION_WIDTH=480
# Procesar 1 de cada N cuadros (los demás reutilizan el último resultado)
PROCESS_EVERY_N_FRAMES=3
CAMERA_RECONNECT_SECONDS=3.0

# --- Credenciales de Acceso al Sistema (RBAC - Solo para primera siembra opcional) ---
ADMIN_USER=admin
ADMIN_PASS=Definir_Password_Seguro_Aqui
ADMIN_NAME="Administrador Principal"

OPERADOR_USER=operador
OPERADOR_PASS=Definir_Password_Seguro_Aqui
OPERADOR_NAME="Operador de Seguridad"

# --- Clave Secreta Criptográfica (AES-256-GCM / LFPDPPP) ---
# Debe ser una cadena aleatoria y única de 64 caracteres hexadecimales (256 bits).
# Si se deja vacía en el primer arranque, el sistema generará una automáticamente.
SECRET_KEY=generar_clave_criptografica_aleatoria_hex_32_bytes
